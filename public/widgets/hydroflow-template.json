{
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "Image",
                  "url": "/pwa-192x192.png",
                  "size": "Small"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "size": "Medium",
                  "weight": "Bolder",
                  "text": "${title}"
                },
                {
                  "type": "TextBlock",
                  "spacing": "None",
                  "isSubtle": true,
                  "text": "${percentage}% of daily goal completed"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "size": "ExtraLarge",
          "weight": "Bolder",
          "color": "Accent",
          "text": "${currentIntake} / ${dailyGoal} ${unit}"
        },
        {
          "type": "TextBlock",
          "text": "Streak: ${streak} days 🔥 | ${remaining} ${unit} remaining",
          "isSubtle": true
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Log Cup (+250ml)",
      "url": "/?action=log_cup"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Log Bottle (+500ml)",
      "url": "/?action=log_bottle"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Open HydroFlow",
      "url": "/"
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5"
}
